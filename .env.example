WORKBENCH_PUBLIC_URL=http://127.0.0.1:18888
# Base origin for the per-host Magpie panels (h-<hash>.<this hostname>). On a VPS this
# needs wildcard DNS (*.domain) and a wildcard certificate; see deploy/Caddyfile.
WORKBENCH_MAGPIE_ORIGIN=
# Version this release reports in the interface, /health and dist/workbench --version.
WORKBENCH_VERSION=development
SIM_PUBLIC_URL=http://127.0.0.1:3000
# Must match third_party/sim; changing this image tag alone does not update its source.
SIM_VERSION=v0.9.25
# Generate each value independently with openssl rand -hex 32; keep them across upgrades.
POSTGRES_PASSWORD=
# Hexadecimal: it is embedded unescaped in REDIS_URL.
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_SECRET=
CRON_SECRET=
# Original SIM defaults for self-hosted use without its optional paid Chat account.
NEXT_PUBLIC_CHAT_DISABLED=true
COPILOT_API_KEY=
# Empty uses localhost:3002 locally and the SIM origin's /socket.io/ behind TLS.
NEXT_PUBLIC_SOCKET_URL=

# VPS profile (docker compose --profile vps up): TLS proxy on the host network.
# WORKBENCH_DOMAIN=wb.example.com
# SIM_DOMAIN=sim.example.com
# ACME_EMAIL=you@example.com   # required by the vps profile (Caddy)
# CADDY_IMAGE=ghcr.io/caddybuilds/caddy-cloudflare:<minor tag>   # only for the wildcard cert
# CADDY_DNS_TOKEN=

# Optional: external OpenAI-compatible embeddings instead of the local Ollama service.
# MEMU_BASE_URL=https://api.openai.com/v1
# MEMU_EMBED_MODEL=text-embedding-3-small
# MEMU_API_KEY=

# memU, Python and local embeddings are installed by Docker/Compose.
# No external embeddings key is required. The model persists in memu_embeddings.
# Native Codex/OMP profiles remain on the Linux hosts selected through SSH.

# Foundry (the Foundry section) runs inside the workbench container with the image's
# Python 3 and keeps its store in the workbench_data volume (<state>/foundry-loop/data),
# so it is covered by scripts/backup.sh. Outside Docker the binary reads, when set:
# WORKBENCH_FOUNDRY_PYTHON=/usr/bin/python3   # needs 3.11+
# WORKBENCH_FOUNDRY_DATA=/absolute/path       # reuse an existing Foundry store
